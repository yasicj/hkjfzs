{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#_1","title":"\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u6837\u5f0f\u8be6\u89e3\uff0c\u9ad8\u6e05\u6837\u672c\u3001\u6392\u7248\u53ca\u6838\u5fc3\u4fe1\u606f\u89e3\u6790","text":"<p>\u5728\u8de8\u5883\u5a5a\u59fb\u3001\u6d89\u5916\u623f\u4ea7\u4ea4\u6613\u3001\u5b50\u5973\u843d\u6237\u4ee5\u53ca\u79fb\u6c11\u7533\u8bf7\u7b49\u8bf8\u591a\u573a\u666f\u4e2d\uff0c\u9999\u6e2f\u7ed3\u5a5a\u8bc1\uff08\u5b98\u65b9\u6b63\u5f0f\u540d\u79f0\u4e3a\u201c\u7ed3\u5a5a\u8bc1\u4e66\u201d\uff0cMarriage Certificate\uff09\u662f\u4e00\u4efd\u81f3\u5173\u91cd\u8981\u7684\u6cd5\u5f8b\u6587\u4ef6\u3002\u7531\u4e8e\u9999\u6e2f\u7684\u6cd5\u5f8b\u4f53\u5236\u3001\u8bed\u8a00\u4e60\u60ef\u4e0e\u5185\u5730\u53ca\u6d77\u5916\u5b58\u5728\u663e\u8457\u5dee\u5f02\uff0c\u8bb8\u591a\u4eba\u5728\u521d\u6b21\u63a5\u89e6\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u65f6\uff0c\u5f80\u5f80\u5bf9\u5176\u72ec\u7279\u7684\u7248\u9762\u6392\u7248\u3001\u7e41\u7b80\u82f1\u53cc\u8bed\u7279\u5f81\u4ee5\u53ca\u6cd5\u5f8b\u6548\u529b\u4ea7\u751f\u7591\u95ee\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u4e3a\u60a8\u5e26\u6765\u5168\u65b9\u4f4d\u7684\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u6837\u5f0f\u8be6\u89e3\uff0c\u4ece\u9ad8\u6e05\u6837\u672c\u7684\u89c6\u89c9\u6392\u7248\u3001\u6838\u5fc3\u5173\u952e\u4fe1\u606f\u89e3\u6790\uff0c\u5230\u4e24\u5730\u4e92\u8ba4\u7684\u5b98\u65b9\u516c\u8bc1\u6d41\u7a0b\uff0c\u5e2e\u52a9\u60a8\u6e05\u6670\u638c\u63e1\u8fd9\u4efd\u91cd\u8981\u8bc1\u4ef6\u7684\u6bcf\u4e00\u4e2a\u7ec6\u8282\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4e66\u7684\u6392\u7248\u5e03\u5c40\u4e0e\u89c6\u89c9\u7279\u5f81","text":"<p>\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u7684\u6574\u4f53\u8bbe\u8ba1\u4f53\u73b0\u4e86\u4e2d\u82f1\u53cc\u8bed\u5e76\u91cd\u7684\u6cd5\u5f8b\u7279\u8272\u3002\u5176\u6392\u7248\u4e25\u8c28\uff0c\u4e0d\u4ec5\u5177\u6709\u9ad8\u5ea6\u7684\u8fa8\u8bc6\u5ea6\uff0c\u8fd8\u5728\u9632\u4f2a and \u683c\u5f0f\u4e0a\u6709\u7740\u4e25\u683c\u7684\u5b98\u65b9\u6807\u51c6\u3002</p>"},{"location":"#1","title":"1. \u6574\u4f53\u89c6\u89c9\u4e0e\u7eb8\u5f20\u89c4\u683c","text":"<p>\u5b98\u65b9\u9881\u53d1\u7684\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4e66\u901a\u5e38\u91c7\u7528\u7279\u5236\u7684\u6cd5\u5f8b\u6587\u4e66\u7eb8\u5f20\uff0c\u8d28\u5730\u575a\u97e7\u3002\u5176\u4e3b\u8272\u8c03\u591a\u4e3a\u6de1\u96c5\u7684\u4e73\u767d\u8272\u6216\u5fae\u5e26\u5e95\u7eb9\u7684\u6d45\u8272\u8c03\uff0c\u56db\u5468\u5e26\u6709\u7cbe\u81f4\u7684\u51e0\u4f55\u9632\u4f2a\u82b1\u8fb9\u3002</p>"},{"location":"#2","title":"2. \u53cc\u8bed\u5bf9\u7167\u7684\u72ec\u7279\u6392\u7248","text":"<p>\u7531\u4e8e\u5386\u53f2\u539f\u56e0\u53ca\u300a\u57fa\u672c\u6cd5\u300b\u89c4\u5b9a\uff0c\u9999\u6e2f\u7684\u6cd5\u5b9a\u8bed\u8a00\u4e3a\u4e2d\u6587\u548c\u82f1\u6587\u3002\u56e0\u6b64\uff0c\u7ed3\u5a5a\u8bc1\u4e66\u4e0a\u7684\u6240\u6709\u56fa\u5b9a\u9879\u76ee\uff08\u5982\u59d3\u540d\u3001\u5e74\u9f84\u3001\u804c\u4e1a\u7b49\u6807\u7b7e\uff09\u5747\u91c7\u7528\u7e41\u4f53\u4e2d\u6587\u4e0e\u82f1\u6587\u4e0a\u4e0b\u5bf9\u7167\u6216\u5de6\u53f3\u5e76\u5217\u7684\u5f62\u5f0f\u5448\u73b0\u3002\u8fd9\u79cd\u53cc\u8bed\u6392\u7248\u4f7f\u5176\u5728\u56fd\u9645\u4e0a\u5177\u6709\u6781\u9ad8\u7684\u76f4\u63a5\u901a\u7528\u5ea6\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001 \u6838\u5fc3\u4fe1\u606f\u89e3\u6790\uff1a\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4e0a\u767b\u8bb0\u4e86\u54ea\u4e9b\u5185\u5bb9\uff1f","text":"<p>\u4f5c\u4e3a\u4e00\u4efd\u5177\u5907\u6700\u9ad8\u6cd5\u5f8b\u6548\u529b\u7684\u8eab\u4efd\u5951\u7ea6\uff0c\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4e66\u4e0a\u627f\u8f7d\u7684\u4fe1\u606f\u975e\u5e38\u4e30\u5bcc\u3002\u6211\u4eec\u5c06\u8bc1\u4e66\u81ea\u4e0a\u800c\u4e0b\u62c6\u89e3\uff0c\u6838\u5fc3\u5185\u5bb9\u4e3b\u8981\u5206\u4e3a\u4ee5\u4e0b\u56db\u5927\u677f\u5757\uff1a</p>"},{"location":"#1_1","title":"1. \u8bc1\u4e66\u9996\u90e8\uff1a\u5b98\u65b9\u6807\u8bc6\u4e0e\u767b\u8bb0\u7f16\u53f7","text":"<ul> <li>\u5a5a\u59fb\u767b\u8bb0\u5904\u540d\u79f0\uff08Marriage Registry\uff09\uff1a\u660e\u786e\u6807\u660e\u8be5\u8bc1\u4e66\u662f\u7531\u9999\u6e2f\u54ea\u4e00\u4e2a\u5b98\u65b9\u5a5a\u59fb\u767b\u8bb0\u5904\uff08\u5982\u5927\u4f1a\u5802\u5a5a\u59fb\u767b\u8bb0\u5904\u3001\u7ea2\u68c9\u8def\u5a5a\u59fb\u767b\u8bb0\u5904\u7b49\uff09\u6216\u7531\u7279\u8bb8\u4e3b\u6301\u5a5a\u793c\u7684\u201c\u5a5a\u793c\u76d1\u793c\u4eba\u201d\u7b7e\u53d1\u3002</li> <li>\u767b\u8bb0\u7f16\u53f7\uff08Registration Number\uff09\uff1a\u4f4d\u4e8e\u8bc1\u4e66\u9876\u90e8\u7684\u552f\u4e00\u4e00\u4e32\u6570\u5b57\uff0c\u8fd9\u662f\u5728\u9999\u6e2f\u5165\u5883\u4e8b\u52a1\u5904\u5a5a\u59fb\u767b\u8bb0\u6240\u5b58\u6863\u7684\u68c0\u7d22\u6838\u5fc3\u3002</li> </ul>"},{"location":"#2_1","title":"2. \u4e2d\u90e8\u6838\u5fc3\uff1a\u65b0\u4eba\u4e0e\u53cc\u65b9\u7236\u4eb2\u7684\u4e2a\u4eba\u6863\u6848","text":"<p>\u8fd9\u662f\u8bc1\u4e66\u6700\u6838\u5fc3\u7684\u8868\u683c\u533a\u57df\uff0c\u8be6\u7ec6\u5217\u51fa\u4e86\u7ed3\u5a5a\u53cc\u65b9\u7684\u5e95\u518c\uff1a * \u7ed3\u5a5a\u53cc\u65b9\u59d3\u540d\uff08Names of Parties\uff09\uff1a\u540c\u65f6\u767b\u8bb0\u65b0\u90ce\u4e0e\u65b0\u5a18\u7684\u4e2d\u6587\u6cd5\u5b9a\u59d3\u540d\uff08\u7e41\u4f53\uff09\u53ca\u82f1\u6587\u62fc\u5199\uff08\u901a\u5e38\u4e0e\u62a4\u7167\u6216\u9999\u6e2f\u8eab\u4efd\u8bc1\u4e00\u81f4\uff09\u3002 * \u5e74\u9f84\u4e0e\u5a5a\u59fb\u72b6\u51b5\uff08Age &amp; Marital Condition\uff09\uff1a\u4e0d\u540c\u4e8e\u5185\u5730\u7ed3\u5a5a\u8bc1\u76f4\u63a5\u5199\u51fa\u751f\u65e5\u671f\uff0c\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u901a\u5e38\u767b\u8bb0\u7ed3\u5a5a\u5f53\u5e74\u7684\u201c\u5b9e\u8db3\u5e74\u9f84\u201d\uff0c\u5e76\u6ce8\u660e\u5a5a\u524d\u72b6\u51b5\uff08\u5982\uff1a\u672a\u5a5a Bachelor/Spinster\u3001\u79bb\u5a5a Divorced \u7b49\uff09\u3002 * \u804c\u4f4d/\u884c\u4e1a\uff08Rank or Profession\uff09\uff1a\u767b\u8bb0\u53cc\u65b9\u5728\u7ed3\u5a5a\u65f6\u7684\u804c\u4e1a\uff0c\u8fd9\u4e00\u9879\u5728\u5185\u5730\u7ed3\u5a5a\u8bc1\u4e2d\u8f83\u4e3a\u5c11\u89c1\u3002 * \u4f4f\u5740\uff08Residence\uff09\uff1a\u53cc\u65b9\u5728\u767b\u8bb0\u7ed3\u5a5a\u65f6\u7684\u5c45\u4f4f\u5730\u5740\u3002 * \u53cc\u65b9\u7236\u4eb2\u7684\u59d3\u540d\u4e0e\u804c\u4e1a\uff08Father's Name &amp; Profession\uff09\uff1a\u8fd9\u662f\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u6700\u5177\u7279\u8272\u7684\u4e00\u70b9\uff0c\u5fc5\u987b\u6e05\u6670\u586b\u5199\u65b0\u90ce\u548c\u65b0\u5a18\u5404\u81ea\u7236\u4eb2\u7684\u59d3\u540d\u4ee5\u53ca\u7236\u4eb2\u7684\u804c\u4e1a\uff0c\u7528\u4ee5\u4f50\u8bc1\u5bb6\u65cf\u8840\u7f18\u80cc\u666f\u3002</p>"},{"location":"#3","title":"3. \u5c3e\u90e8\uff1a\u7b7e\u7f72\u4e0e\u89c1\u8bc1\u4eba\u533a\u57df","text":"<ul> <li>\u5a5a\u793c\u4e3e\u884c\u5730\u70b9\uff08Place of Marriage\uff09\uff1a\u5199\u660e\u4e3e\u529e\u5a5a\u793c\u7684\u5177\u4f53\u793c\u5802\u3001\u6559\u5802\u6216\u76d1\u793c\u4eba\u4e8b\u52a1\u6240\u5730\u5740\u3002</li> <li>\u56db\u4eba\u7b7e\u7f72\uff08Signatures\uff09\uff1a\u8bc1\u4e66\u5e95\u90e8\u5fc5\u987b\u7531\u65b0\u90ce\u3001\u65b0\u5a18\u4ee5\u53ca\u81f3\u5c11\u4e24\u4f4d\u6210\u5e74\u89c1\u8bc1\u4eba\uff08Witnesses\uff09\u73b0\u573a\u4eb2\u7b14\u7b7e\u7f72\u3002</li> <li>\u767b\u8bb0\u5b98/\u76d1\u793c\u4eba\u7b7e\u7ae0\uff08Signature of Registrar/Celebrating Officer\uff09\uff1a\u7531\u4e3b\u6301\u5a5a\u793c\u7684\u5b98\u65b9\u767b\u8bb0\u5b98\u6216\u83b7\u6388\u6743\u7684\u5a5a\u59fb\u76d1\u793c\u4eba\uff08\u901a\u5e38\u4e3a\u9999\u6e2f\u6267\u4e1a\u5f8b\u5e08\uff09\u7b7e\u5b57\u76d6\u7ae0\uff0c\u8bc1\u4e66\u65b9\u59cb\u751f\u6548\u3002</li> </ul>"},{"location":"#_4","title":"\u4e09\u3001\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u5728\u5185\u5730\u7684\u6cd5\u5f8b\u6548\u529b\u4e0e\u516c\u8bc1\u6d41\u7a0b","text":"<p>\u8bb8\u591a\u5728\u9999\u6e2f\u6ce8\u518c\u7ed3\u5a5a\u7684\u65b0\u4eba\uff0c\u56de\u5230\u5185\u5730\u751f\u6d3b\u3001\u4e70\u623f\u3001\u751f\u5b50\u6216\u843d\u6237\u65f6\uff0c\u5f80\u5f80\u4f1a\u9047\u5230\u4e00\u4e2a\u9ad8\u9891\u75db\u70b9\uff1a\u5185\u5730\u6c11\u653f\u5c40\u3001\u623f\u7ba1\u5c40\u6216\u516c\u5b89\u5c40\u65e0\u6cd5\u76f4\u63a5\u8bc6\u522b\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u3002 </p> <p>\u8fd9\u662f\u56e0\u4e3a\u4e24\u5730\u6cd5\u5236\u4e0d\u540c\u3002\u8981\u5728\u5185\u5730\u5408\u6cd5\u4f7f\u7528\u9999\u6e2f\u7ed3\u5a5a\u8bc1\uff0c\u5fc5\u987b\u7ecf\u8fc7\u5408\u89c4\u7684\u8de8\u5883\u5916\u53d1\u786e\u8ba4\u7a0b\u5e8f\u3002</p>"},{"location":"#1_2","title":"1. \u4e3a\u4ec0\u4e48\u8981\u529e\u7406\u201c\u4e2d\u56fd\u59d4\u6258\u516c\u8bc1\u201d\uff1f","text":"<p>\u6839\u636e\u53f8\u6cd5\u90e8\u89c4\u5b9a\uff0c\u9999\u6e2f\u5f62\u6210\u7684\u6cd5\u5f8b\u6587\u4e66\u5728\u5185\u5730\u4f7f\u7528\uff0c\u5fc5\u987b\u7ecf\u8fc7\u4e2d\u56fd\u6cd5\u5f8b\u670d\u52a1\uff08\u9999\u6e2f\uff09\u6709\u9650\u516c\u53f8\uff08\u7b80\u79f0\u201c\u4e2d\u6cd5\u5f8b\u201d\uff09\u4f20\u9012\uff0c\u5e76\u52a0\u76d6\u8f6c\u9012\u7ae0\u3002\u672a\u7ecf\u516c\u8bc1\u8f6c\u9012\u7684\u9999\u6e2f\u7ed3\u5a5a\u8bc1\uff0c\u5728\u5185\u5730\u4e0d\u5177\u5907\u884c\u653f and \u53f8\u6cd5\u5c42\u9762\u7684\u6cd5\u5f8b\u6548\u529b\u3002</p>"},{"location":"#2_2","title":"2. \u5b98\u65b9\u8ba4\u53ef\u7684\u516c\u8bc1\u529e\u7406\u6b65\u9aa4","text":"<ol> <li>\u5bfb\u627e\u516c\u8bc1\u4eba\uff1a\u5fc5\u987b\u59d4\u6258\u7ecf\u4e2d\u56fd\u53f8\u6cd5\u90e8\u7279\u8bb8\u7684\u4e2d\u56fd\u59d4\u6258\u516c\u8bc1\u4eba\uff08\u9999\u6e2f\u6267\u4e1a\u5f8b\u5e08\uff09\u8fdb\u884c\u529e\u7406\uff0c\u666e\u901a\u5f8b\u5e08\u65e0\u6b64\u6743\u9650\u3002</li> <li>\u63d0\u4ea4\u6750\u6599\uff1a\u5411\u5f8b\u5e08\u697c\u63d0\u4f9b\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u539f\u4ef6\u3001\u53cc\u65b9\u8eab\u4efd\u8bc1\u4ef6\uff08\u56de\u4e61\u8bc1\u3001\u8eab\u4efd\u8bc1\u6216\u62a4\u7167\uff09\u3002</li> <li>\u5236\u4f5c\u516c\u8bc1\u4e66\uff1a\u59d4\u6258\u516c\u8bc1\u4eba\u6838\u5b9e\u8bc1\u4e66\u771f\u5b9e\u6027\u540e\uff0c\u5236\u4f5c\u56fa\u5b9a\u683c\u5f0f\u7684\u6d89\u5916\u516c\u8bc1\u4e66\u3002</li> <li>\u52a0\u7ae0\u8f6c\u9012\uff1a\u5c06\u516c\u8bc1\u4e66\u9001\u5f80\u4e2d\u6cd5\u5f8b\uff08China Legal Service\uff09\u8fdb\u884c\u52a0\u76d6\u8f6c\u9012\u7ae0\u3002</li> <li>\u5185\u5730\u4f7f\u7528\uff1a\u8f6c\u9012\u5b8c\u6210\u540e\uff0c\u516c\u8bc1\u4e66\u4f1a\u5bc4\u9001\u81f3\u5185\u5730\u7684\u4f7f\u7528\u90e8\u95e8\uff0c\u6b64\u65f6\u4fbf\u53ef\u5728\u5185\u5730\u7545\u901a\u65e0\u963b\u5730\u7528\u4e8e\u843d\u6237\u3001\u4e70\u623f\u6216\u8bc9\u8bbc\u3002</li> </ol>"},{"location":"#_5","title":"\u56db\u3001\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4e66\u7684\u5b98\u65b9\u8865\u9886\u4e0e\u526f\u672c\u7533\u8bf7\u6307\u5357","text":"<p>\u5728\u6d77\u5916\u79fb\u6c11\u6216\u957f\u671f\u5c45\u7559\u7684\u534e\u4eba\u5708\u4e2d\uff0c\u7ecf\u5e38\u4f1a\u9047\u5230\u201c\u7ed3\u5a5a\u8bc1\u4e0d\u614e\u9057\u5931\u201d\u6216\u201c\u9700\u8981\u5411\u6d77\u5916\u9012\u4ea4\u591a\u4efd\u539f\u4ef6\u201d\u7684\u60c5\u51b5\u3002\u7531\u4e8e\u8c37\u6b4c\u641c\u7d22\u7528\u6237\u591a\u5177\u5907\u8de8\u5883\u3001\u79fb\u6c11\u80cc\u666f\uff0c\u201c\u5982\u4f55\u8865\u9886\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u526f\u672c\u201d\u6210\u4e3a\u4e86\u5e38\u5e74\u5c45\u9ad8\u4e0d\u4e0b\u7684\u641c\u7d22\u70ed\u8bcd\u3002</p> <p>\u9999\u6e2f\u7684\u5236\u5ea6\u975e\u5e38\u4eba\u6027\u5316\uff0c\u5373\u4f7f\u60a8\u4eba\u4e0d\u5728\u9999\u6e2f\uff0c\u6216\u8005\u539f\u4ef6\u4e22\u5931\uff0c\u4e5f\u53ef\u4ee5\u901a\u8fc7\u5b98\u65b9\u6e20\u9053\u7533\u8bf7\u6838\u8bc1\u526f\u672c\uff08Certified Copy\uff09\u3002\u5728\u6cd5\u5f8b\u4e0a\uff0c\u6838\u8bc1\u526f\u672c\u7b49\u540c\u4e8e\u539f\u4ef6\u6548\u529b\u3002</p>"},{"location":"#1_3","title":"1. \u5b98\u65b9\u7533\u8bf7\u6e20\u9053","text":"<p>\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4e66\u7684\u6863\u6848\u7531\u9999\u6e2f\u5165\u5883\u4e8b\u52a1\u5904\uff08Immigration Department\uff09\u7edf\u4e00\u7ba1\u7406\u3002\u7533\u8bf7\u4eba\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u4e09\u79cd\u65b9\u5f0f\u63d0\u51fa\u8865\u9886\uff1a * \u4eb2\u81ea\u524d\u5f80\uff1a\u76f4\u63a5\u5230\u9999\u6e2f\u4efb\u4f55\u4e00\u95f4\u5a5a\u59fb\u767b\u8bb0\u5904\u9012\u4ea4\u7533\u8bf7\u3002 * \u90ae\u5bc4\u7533\u8bf7\uff1a\u5c06\u586b\u59a5\u7684\u7533\u8bf7\u8868\u683c\u3001\u8eab\u4efd\u8bc1\u660e\u6587\u4ef6\u526f\u672c\u53ca\u8d39\u7528\uff08\u6c47\u7968\uff09\u90ae\u5bc4\u81f3\u9999\u6e2f\u5a5a\u59fb\u767b\u8bb0\u4e2d\u592e\u7eaa\u5f55\u7559\u5b58\u5904\u3002 * \u7f51\u4e0a\u7533\u8bf7\uff1a\u901a\u8fc7\u9999\u6e2f\u653f\u5e9c\u4e00\u7ad9\u901a\uff08GovHK\uff09\u5b98\u65b9\u7f51\u7ad9\u5728\u7ebf\u63d0\u4ea4\u7ffb\u67e5\u5a5a\u59fb\u767b\u8bb0\u7eaa\u5f55\u7684\u7533\u8bf7\u3002</p>"},{"location":"#2_3","title":"2. \u6838\u5fc3\u529e\u7406\u6d41\u7a0b\u4e0e\u5468\u671f","text":"<ol> <li>\u7ffb\u67e5\u7eaa\u5f55\uff08Search Notice\uff09\uff1a\u9996\u5148\u9700\u8981\u5411\u5165\u5883\u5904\u7533\u8bf7\u201c\u7ffb\u67e5\u5a5a\u59fb\u767b\u8bb0\u7eaa\u5f55\u201d\uff0c\u4ee5\u786e\u5b9a\u5f53\u5e74\u7684\u767b\u8bb0\u5e95\u518c\u3002</li> <li>\u7f34\u7eb3\u7ffb\u67e5\u8d39\uff1a\u6839\u636e\u5b98\u65b9\u6307\u5f15\u7f34\u7eb3\u7279\u5b9a\u7684\u7ffb\u67e5\u8d39\u7528\u3002</li> <li>\u7b7e\u53d1\u526f\u672c\uff1a\u67e5\u5b9e\u7eaa\u5f55\u540e\uff0c\u5165\u5883\u5904\u4f1a\u6839\u636e\u7eaa\u5f55\u7b7e\u53d1\u4e00\u4efd\u76d6\u6709\u5b98\u65b9\u7ea2\u5370\u7684\u7ed3\u5a5a\u8bc1\u4e66\u6838\u8bc1\u526f\u672c\u3002</li> <li>\u529e\u7406\u5468\u671f\uff1a\u4eb2\u81ea\u529e\u7406\u901a\u5e38\u53ef\u5728\u6570\u4e2a\u5de5\u4f5c\u65e5\u5185\u5b8c\u6210\u7ffb\u67e5\u5e76\u9886\u8bc1\uff1b\u90ae\u5bc4\u6216\u7f51\u7edc\u529e\u7406\u56e0\u6d89\u53ca\u8de8\u5883\u90ae\u5bc4\uff0c\u901a\u5e38\u9700\u89812\u81f34\u5468\u65f6\u95f4\u3002</li> </ol>"},{"location":"#_6","title":"\u4e94\u3001 \u7ed3\u8bed\u4e0e\u5408\u89c4\u5efa\u8bae","text":"<p>\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4ee5\u5176\u7cbe\u6e5b\u7684\u53cc\u8bed\u6392\u7248\u548c\u4e25\u8c28\u7684\u4fe1\u606f\u767b\u8bb0\uff0c\u6210\u4e3a\u4e86\u8de8\u5883\u5a5a\u59fb\u4e2d\u4e00\u4efd\u542b\u91d1\u91cf\u6781\u9ad8\u7684\u6cd5\u5f8b\u5951\u7ea6\u3002\u65e0\u8bba\u60a8\u662f\u4e3a\u4e86\u7559\u4f5c\u7eaa\u5ff5\u800c\u4e86\u89e3\u5176\u6837\u5f0f\u6392\u7248\uff0c\u8fd8\u662f\u56e0\u751f\u6d3b\u6240\u9700\u9700\u8981\u529e\u7406\u4e24\u5730\u4e92\u8ba4\u7684\u516c\u8bc1\u8f6c\u9012\uff0c\u6291\u6216\u662f\u9762\u4e34\u8bc1\u4e66\u9057\u5931\u9700\u8981\u5411\u5165\u5883\u5904\u7533\u8bf7\u8865\u9886\u526f\u672c\uff0c\u90fd\u8bf7\u52a1\u5fc5\u8ba4\u51c6\u9999\u6e2f\u5165\u5883\u4e8b\u52a1\u5904\u5b98\u7f51\u4ee5\u53ca\u53f8\u6cd5\u90e8\u6307\u5b9a\u7684\u4e2d\u56fd\u59d4\u6258\u516c\u8bc1\u4eba\u7b49\u5b98\u65b9\u5408\u89c4\u6e20\u9053\u3002</p> <p>\u638c\u63e1\u6b63\u786e\u7684\u7533\u529e\u77e5\u8bc6\u4e0e\u5408\u89c4\u6d41\u7a0b\uff0c\u4e0d\u4ec5\u80fd\u8ba9\u60a8\u7684\u8de8\u5883\u8eab\u4efd\u8ba4\u8bc1\u4e4b\u8def\u66f4\u52a0\u987a\u7545\uff0c\u4e5f\u80fd\u8ba9\u8fd9\u4efd\u8c61\u5f81\u7231\u60c5\u7684\u6cd5\u5f8b\u5951\u7ea6\u5728\u5173\u952e\u65f6\u523b\u53d1\u6325\u5176\u5e94\u6709\u7684\u4fdd\u62a4\u4f5c\u7528\u3002</p>"}]}